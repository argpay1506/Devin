{
  "name": "bioar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BioAR web prototype: molecular structure viewer, cartoon/impostor rendering, LOD, and an interface scoring sandbox.",
  "scripts": {
